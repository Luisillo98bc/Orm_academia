# Copiar como deploy/.env.production en la VM. Nunca subir el archivo real.
POSTGRES_PASSWORD=genera-una-clave-larga-y-aleatoria
DATABASE_URL=postgresql://postgres:genera-una-clave-larga-y-aleatoria@db:5432/academia_virtual?schema=public
DIRECT_URL=postgresql://postgres:genera-una-clave-larga-y-aleatoria@db:5432/academia_virtual?schema=public

JWT_SECRET=genera-una-clave-aleatoria-de-al-menos-32-caracteres
TWO_FACTOR_ENCRYPTION_KEY=genera-otra-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
NODE_ENV=production
# Cloudflare Tunnel conecta directamente con el backend: un proxy confiable.
TRUST_PROXY_HOPS=1

CORS_ORIGIN=https://academia.luisenriquebautistacoz.com
FRONTEND_URL=https://academia.luisenriquebautistacoz.com
NEXT_PUBLIC_API_URL=https://academia.luisenriquebautistacoz.com/api/v1
NEXT_PUBLIC_SITE_URL=https://academia.luisenriquebautistacoz.com
NEXT_PUBLIC_WS_URL=https://academia.luisenriquebautistacoz.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
INITIAL_ADMIN_EMAIL=admin@tu-dominio.com
INITIAL_ADMIN_PASSWORD=genera-una-contraseña-inicial-única

STORAGE_PROVIDER=minio
MINIO_IMAGE=academia_virtual_minio:community-7aac2a2c
MINIO_MC_IMAGE=academia_virtual_minio-mc:community-77f82e18
MINIO_COMMIT=7aac2a2c5b7c882e68c1ce017d8256be2feea27f
MC_COMMIT=77f82e18b5401a65958f1619df6ebb994634bd88
MINIO_ROOT_USER=cambia-este-usuario-root
MINIO_ROOT_PASSWORD=genera-otra-clave-larga-para-minio-root
MINIO_ACCESS_KEY=academia-app
MINIO_SECRET_KEY=genera-una-clave-larga-para-el-usuario-app
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=3600
PRIVATE_STORAGE_DIR=/app/backend/private-uploads
CLAMAV_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
STORAGE_BUCKET_QUOTA_BYTES=10737418240

PAYMENTS_MODE=cash
ENABLE_SCHEDULED_JOBS=true
SCHEDULED_JOBS_MODE=inline
CONTRACT_ALERT_INTERVAL_MS=86400000
CERTIFICATE_AUTO_INTERVAL_MS=86400000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=notificaciones@tu-dominio.com
MAIL_PASS=tu-password-de-aplicacion
MAIL_FROM=Academia Virtual <noreply@tu-dominio.com>
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=1000

# Monitoring: the script alerts when a service fails or disk usage is high.
MONITOR_DISK_PATH=/
DISK_ALERT_PERCENT=80
# Optional Slack-compatible webhook receiving {"text":"..."}.
MONITOR_ALERT_WEBHOOK_URL=

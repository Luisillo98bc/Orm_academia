{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::avatars", "arn:aws:s3:::courses", "arn:aws:s3:::cohorts", "arn:aws:s3:::materials", "arn:aws:s3:::vouchers", "arn:aws:s3:::deliverables"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::vouchers/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::avatars/*",
        "arn:aws:s3:::courses/*",
        "arn:aws:s3:::cohorts/*",
        "arn:aws:s3:::materials/*",
        "arn:aws:s3:::vouchers/*",
        "arn:aws:s3:::deliverables/*"
      ]
    }
  ]
}

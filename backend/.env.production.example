# ============================================================================
# Variables de Entorno para Producción (Railway / Render + Supabase)
# ============================================================================

# ── Supabase PostgreSQL Database ──
# DATABASE_URL: Usar la URL con Connection Pooling (Puerto 6543 en Supabase)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Usar la conexión directa (Puerto 5432) para ejecutar migraciones
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── JWT ──
JWT_SECRET="genera-una-clave-secreta-larga-y-aleatoria-para-produccion"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── Servidor ──
PORT=3000
NODE_ENV=production

# ── CORS ──
# Incluir tu dominio de Vercel / producción
CORS_ORIGIN="https://tu-academia.vercel.app,http://localhost:3000"

# ── Supabase Storage ──
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://[tu-proyecto].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# ── Pasarela de Pagos (Culqi) ──
CULQI_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx
FRONTEND_URL=https://tu-academia.vercel.app

# ── SMTP / Mailer (Opcional para envio de correos) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=notificaciones@tu-academia.com
MAIL_PASS=tu-password-de-aplicacion
MAIL_FROM="Academia Virtual <noreply@tu-academia.com>"

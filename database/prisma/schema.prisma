// ============================================================================
// Schema Prisma — Módulo de Seguridad y RBAC
// ERP + LMS Educativo | Monolito Modular
// ============================================================================

generator client {
  provider   = "prisma-client-js"
  output     = "../../backend/node_modules/.prisma/client"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC: Roles y Permisos
// ─────────────────────────────────────────────────────────────────────────────

/// Rol del sistema (e.g. ADMIN, DOCENTE, ESTUDIANTE, RRHH).
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relaciones
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permiso granular del sistema (e.g. users:create, courses:read).
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  action      String    @db.VarChar(100) // e.g. "create", "read", "update", "delete"
  subject     String    @db.VarChar(100) // e.g. "users", "courses", "enrollments"
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relaciones
  roles RolePermission[]

  // Un permiso es único por combinación action + subject
  @@unique([action, subject])
  @@map("permissions")
}

/// Tabla pivot explícita Role ↔ Permission (many-to-many).
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuarios
// ─────────────────────────────────────────────────────────────────────────────

/// Usuario del sistema con soporte para soft delete y auditoría.
model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  googleSubject     String?   @unique @map("google_subject") @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  profilePicture    String?   @map("profile_picture") @db.VarChar(500)
  dni               String?   @unique @db.VarChar(8)
  phone             String?   @db.VarChar(20)
  address           String?   @db.VarChar(500)
  district          String?   @db.VarChar(100)
  province          String?   @db.VarChar(100)
  department        String?   @db.VarChar(100)
  isActive          Boolean   @default(true) @map("is_active")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret") @db.VarChar(255)
  resetToken        String?   @map("reset_token") @db.VarChar(255)
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relaciones — RBAC
  roles           UserRole[]
  auditLogs       AuditLog[]
  refreshSessions RefreshSession[]

  // Relaciones — Académicas
  taughtCohorts Cohort[]      @relation("CohortTeachers")
  enrollments   Enrollment[]
  deliverables  Deliverable[]
  givenGrades   Grade[]       @relation("GradeGrader")

  // Relaciones — Fases 4, 6 y 7
  workerProfile           Worker?
  classAttendances        ClassAttendance[]       @relation("StudentAttendance")
  teacherEvaluations      TeacherEvaluation[]     @relation("EvaluatedTeacher")
  studentEvaluations      TeacherEvaluation[]     @relation("EvaluatingStudent")
  authoredAnnouncements   Announcement[]          @relation("AnnouncementAuthor")
  authoredForumMessages   ForumMessage[]          @relation("ForumMessageAuthor")
  authoredForums          Forum[]                 @relation("ForumAuthor")
  notifications           Notification[]          @relation("UserNotifications")
  notificationDeliveries  NotificationDelivery[]
  notificationPreference  NotificationPreference?
  favoriteCohorts         CohortFavorite[]
  issuedCertificates      Certificate[]           @relation("CertificateIssuer")
  signedContracts         Contract[]              @relation("ContractSigner")
  approvedContracts       Contract[]              @relation("ContractApprover")
  assignedProspects       Prospect[]              @relation("ProspectAssignee")
  prospectNotes           ProspectNote[]          @relation("ProspectNoteAuthor")
  materialProgress        MaterialProgress[]
  supportTicketsRequested SupportTicket[]         @relation("SupportTicketRequester")
  supportTicketsAssigned  SupportTicket[]         @relation("SupportTicketAssignee")
  supportTicketMessages   SupportTicketMessage[]
  createdOperatingCosts   OperatingCost[]         @relation("OperatingCostCreator")
  contentVersions         ContentVersion[]
  classroomPosts          ClassroomPost[]
  quizAttempts            QuizAttempt[]

  // Relaciones — Mensajería directa
  sentDirectMessages     DirectMessage[] @relation("DMSender")
  receivedDirectMessages DirectMessage[] @relation("DMReceiver")

  @@index([isActive, deletedAt])
  @@map("users")
}

/// Sesión renovable. El token real solo vive en una cookie HttpOnly;
/// la base de datos conserva exclusivamente su hash SHA-256.
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Tabla pivot explícita User ↔ Role (many-to-many).
model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoría y Trazabilidad
// ─────────────────────────────────────────────────────────────────────────────

/// Registro de auditoría para trazabilidad de operaciones críticas.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100) // e.g. "LOGIN", "CREATE_USER", "UPDATE_ROLE"
  entity    String   @db.VarChar(100) // e.g. "User", "Role", "Permission"
  entityId  String?  @map("entity_id") @db.Uuid
  oldValue  Json?    @map("old_value") // Snapshot del estado anterior
  newValue  Json?    @map("new_value") // Snapshot del estado nuevo
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  // Relación con el usuario que ejecutó la acción
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — Dominio Académico
// ─────────────────────────────────────────────────────────────────────────────

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  PENDING_PAYMENT
  COMPLETED
  DROPPED
  SUSPENDED
}

enum PaymentMethod {
  TARJETA
  YAPE
  PLIN
  EFECTIVO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum MaterialType {
  PPT
  PDF
  REPOSITORY
  VIDEO
  LINK
}

enum DeliverableStatus {
  PENDING // Entregado, pendiente de revisión
  GRADED // Calificado por el docente
  RETURNED // Devuelto para correcciones
  LATE // Entregado fuera de plazo
}

enum GradeStatus {
  DRAFT // Calificación provisional
  PUBLISHED // Calificación publicada al estudiante
}

enum CertificateType {
  COMPLETION
  GRADES
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio Académico: Cursos y Cohortes
// ─────────────────────────────────────────────────────────────────────────────

/// Catálogo general de cursos ofrecidos por la academia.
model Course {
  id                  String      @id @default(uuid()) @db.Uuid
  code                String      @unique @db.VarChar(20) // e.g. "PY-101", "JS-201"
  name                String      @db.VarChar(200)
  description         String?     @db.Text
  promotionalVideoUrl String?     @map("promotional_video_url") @db.VarChar(500)
  whatYouWillLearn    String?     @map("what_you_will_learn") @db.Text
  requirements        String?     @db.Text
  targetAudience      String?     @map("target_audience") @db.Text
  level               CourseLevel @default(BEGINNER)
  durationHours       Int         @default(0) @map("duration_hours")
  imageUrl            String?     @map("image_url") @db.VarChar(500)
  isPublished         Boolean     @default(false) @map("is_published")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deletedAt           DateTime?   @map("deleted_at")

  // Relaciones
  cohorts        Cohort[]
  operatingCosts OperatingCost[]

  @@index([level])
  @@index([isPublished, deletedAt])
  @@map("courses")
}

/// Instancia específica de un curso con fechas, docente y sala virtual.
/// Un mismo curso puede tener múltiples cohortes (e.g. "Python Básico - Enero 2026").
model Cohort {
  id                 String    @id @default(uuid()) @db.Uuid
  courseId           String    @map("course_id") @db.Uuid
  name               String    @db.VarChar(200) // e.g. "Python Básico - Turno Mañana"
  modality           String    @default("ONLINE") @db.VarChar(30)
  schedule           String?   @db.VarChar(255)
  googleMeetLink     String?   @map("google_meet_link") @db.VarChar(500)
  price              Decimal   @default(0) @db.Decimal(12, 2)
  installments       Int       @default(1) @map("installments")
  discountPercentage Float     @default(0) @map("discount_percentage")
  discountEndsAt     DateTime? @map("discount_ends_at")
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  maxStudents        Int       @default(30) @map("max_students")
  startDate          DateTime  @map("start_date")
  endDate            DateTime  @map("end_date")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relaciones
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teachers           User[]              @relation("CohortTeachers")
  enrollments        Enrollment[]
  evaluations        Evaluation[]
  classAttendances   ClassAttendance[]
  teacherEvaluations TeacherEvaluation[]
  forums             Forum[]
  syllabusModules    SyllabusModule[]
  prospects          Prospect[]
  favorites          CohortFavorite[]
  operatingCosts     OperatingCost[]
  classroomPosts     ClassroomPost[]
  questionBank       ClassroomQuestion[]

  @@index([courseId])
  @@index([startDate, endDate])
  @@index([isActive, deletedAt, endDate])
  @@map("cohorts")
}

model CohortFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  cohortId  String   @map("cohort_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([userId, createdAt])
  @@map("cohort_favorites")
}

/// Matrícula de un estudiante en una cohorte específica.
model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  cohortId    String           @map("cohort_id") @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  reservationExpiresAt DateTime? @map("reservation_expires_at")
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  // Relaciones
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort       Cohort        @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  payment      Payment?
  certificates Certificate[]

  // Un estudiante solo puede matricularse una vez por cohorte
  @@unique([userId, cohortId])
  @@index([status])
  @@index([cohortId, status, reservationExpiresAt])
  @@map("enrollments")
}

/// Registro de pago para una matrícula.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  enrollmentId    String        @unique @map("enrollment_id") @db.Uuid
  idempotencyKey  String?       @unique @map("idempotency_key") @db.VarChar(64)
  culqiOrderId    String?       @unique @map("culqi_order_id") @db.VarChar(40)
  culqiChargeId   String?       @unique @map("culqi_charge_id") @db.VarChar(40)
  culqiEventId    String?       @unique @map("culqi_event_id") @db.VarChar(50)
  chargeAttemptKey String?      @map("charge_attempt_key") @db.VarChar(80)
  chargeStartedAt DateTime?     @map("charge_started_at")
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  installmentNumber  Int           @default(1) @map("installment_number")
  totalInstallments  Int           @default(1) @map("total_installments")
  paidInstallments   Int           @default(0) @map("paid_installments")
  nextDueDate        DateTime?     @map("next_due_date")
  installmentHistory Json?         @map("installment_history")
  voucherUrl         String?       @map("voucher_url") @db.VarChar(1000)
  validatedAt     DateTime?     @map("validated_at")
  rejectedAt      DateTime?     @map("rejected_at")
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([voucherUrl])
  @@map("payments")
}

/// Evento anónimo del embudo comercial. No almacena correos, nombres ni datos bancarios.
model ConversionEvent {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.VarChar(64)
  event      String   @db.VarChar(50)
  path       String?  @db.VarChar(500)
  cohortId   String?  @map("cohort_id") @db.Uuid
  paymentId  String?  @map("payment_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([event, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([cohortId, event])
  @@map("conversion_events")
}

/// Certificado académico verificable.
model Certificate {
  id               String          @id @default(uuid()) @db.Uuid
  code             String          @unique @db.VarChar(50) // Código único de validación (ej. CERT-A1B2)
  enrollmentId     String          @map("enrollment_id") @db.Uuid
  type             CertificateType @default(COMPLETION)
  issueDate        DateTime        @default(now()) @map("issue_date")
  issuedBy         String?         @map("issued_by") @db.Uuid // Usuario que lo emitió (null = automático)
  finalGrade       Float?          @map("final_grade")
  attendanceRate   Float?          @map("attendance_rate")
  templateVersion  String          @default("v1") @map("template_version") @db.VarChar(30)
  revokedAt        DateTime?       @map("revoked_at")
  revocationReason String?         @map("revocation_reason") @db.VarChar(500)
  createdAt        DateTime        @default(now()) @map("created_at")

  // Relaciones
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  issuer     User?      @relation("CertificateIssuer", fields: [issuedBy], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, type])
  @@map("certificates")
}

/// Módulo o Semana de estudio dentro de una Cohorte
model SyllabusModule {
  id          String   @id @default(uuid()) @db.Uuid
  cohortId    String   @map("cohort_id") @db.Uuid
  title       String   @db.VarChar(200) // e.g. "Semana 1: Introducción"
  description String?  @db.Text
  order       Int      @default(0) // Orden de visualización
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cohort      Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  materials   Material[]
  sessions    ClassSession[]
  evaluations Evaluation[] // Evaluaciones asociadas a este módulo

  @@index([cohortId])
  @@map("syllabus_modules")
}

/// Materiales descargables por módulo
model Material {
  id        String       @id @default(uuid()) @db.Uuid
  moduleId  String       @map("module_id") @db.Uuid
  title     String       @db.VarChar(200)
  type      MaterialType
  fileUrl   String       @map("file_url") @db.VarChar(1000)
  createdAt DateTime     @default(now()) @map("created_at")

  module   SyllabusModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress MaterialProgress[]

  @@index([moduleId])
  @@index([fileUrl])
  @@map("materials")
}

model MaterialProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  materialId  String    @map("material_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@map("material_progress")
}

/// Sesión Sincrónica grabada de un módulo
model ClassSession {
  id           String   @id @default(uuid()) @db.Uuid
  moduleId     String   @map("module_id") @db.Uuid
  title        String   @db.VarChar(200)
  date         DateTime @db.Timestamptz(3)
  meetLink     String?  @map("meet_link") @db.VarChar(500)
  recordingUrl String?  @map("recording_url") @db.VarChar(1000)
  durationMinutes Int   @default(60) @map("duration_minutes")
  timeZone     String   @default("America/Lima") @map("time_zone") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")

  module      SyllabusModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attendances ClassAttendance[]

  @@index([moduleId])
  @@index([moduleId, date])
  @@map("class_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dominio de Evaluaciones: Tareas, Entregas y Calificaciones
// ─────────────────────────────────────────────────────────────────────────────

/// Evaluación (tarea/proyecto) asignada a una cohorte.
/// El peso (weight) representa el porcentaje sobre la nota final.
model Evaluation {
  id          String    @id @default(uuid()) @db.Uuid
  cohortId    String    @map("cohort_id") @db.Uuid
  moduleId    String?   @map("module_id") @db.Uuid
  title       String    @db.VarChar(300) // e.g. "Proyecto Final: Batalla del Caballero y el Ogro"
  description String?   @db.Text // Instrucciones detalladas de la evaluación
  weight      Float     @default(0) // Porcentaje sobre la nota final (0–100)
  maxScore    Float     @default(20) @map("max_score") // Nota máxima (escala 0–20)
  dueDate     DateTime? @map("due_date") // Fecha límite de entrega
  isPublished Boolean   @default(false) @map("is_published")
  kind        String    @default("ASSIGNMENT") @db.VarChar(20)
  allowResubmit Boolean @default(true) @map("allow_resubmit")
  allowLate   Boolean   @default(true) @map("allow_late")
  rubric      Json?
  quiz        Json?
  maxAttempts Int       @default(1) @map("max_attempts")
  timeLimitMinutes Int  @default(30) @map("time_limit_minutes")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relaciones
  cohort       Cohort          @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  module       SyllabusModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  deliverables Deliverable[]
  quizAttempts QuizAttempt[]

  @@index([cohortId])
  @@index([dueDate])
  @@map("evaluations")
}

/// Entrega de un estudiante para una evaluación.
/// fileUrl almacena el enlace al repositorio o archivo de código.
model Deliverable {
  id           String            @id @default(uuid()) @db.Uuid
  evaluationId String            @map("evaluation_id") @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  fileUrl      String            @map("file_url") @db.VarChar(1000) // URL del repo/archivo
  fileName     String?           @map("file_name") @db.VarChar(255) // Nombre original del archivo
  comment      String?           @db.Text // Comentario del estudiante
  status       DeliverableStatus @default(PENDING)
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  // Relaciones
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade? // Un entregable tiene una sola calificación (1:1)
  revisions  SubmissionRevision[]

  // Un estudiante solo puede entregar una vez por evaluación
  @@unique([evaluationId, studentId])
  @@index([status])
  @@index([submittedAt])
  @@index([fileUrl])
  @@map("deliverables")
}

/// Calificación otorgada por el docente a un entregable.
/// Relación 1:1 con Deliverable.
model Grade {
  id            String      @id @default(uuid()) @db.Uuid
  deliverableId String      @unique @map("deliverable_id") @db.Uuid
  graderId      String      @map("grader_id") @db.Uuid // Docente que califica
  score         Float // Nota numérica (0–20)
  feedback      String?     @db.Text // Retroalimentación cualitativa
  status        GradeStatus @default(DRAFT)
  rubricScores Json? @map("rubric_scores")
  gradedAt      DateTime    @default(now()) @map("graded_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  // Relaciones
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  grader      User        @relation("GradeGrader", fields: [graderId], references: [id], onDelete: Restrict)

  @@index([graderId])
  @@index([status])
  @@map("grades")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 6: Recursos Humanos (RRHH)
// ─────────────────────────────────────────────────────────────────────────────

enum WorkerStatus {
  ACTIVE
  INACTIVE
  VACATION
  LEAVE
}

enum ContractType {
  INDEFINITE
  FIXED_TERM
  INTERNSHIP
  FREELANCE
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  REJECTED
  APPROVED
  EXPIRED
  CANCELLED
}

enum PayrollStatus {
  PENDING
  PAID
  ON_HOLD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  VACATION
}

model Worker {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  dni           String       @unique @db.VarChar(15)
  position      String       @db.VarChar(100)
  department    String       @db.VarChar(50)
  baseSalary    Decimal      @map("base_salary") @db.Decimal(12, 2)
  hireDate      DateTime     @map("hire_date")
  status        WorkerStatus @default(ACTIVE)
  personalPhone String?      @map("personal_phone") @db.VarChar(20)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  contracts   Contract[]
  payrolls    Payroll[]
  attendances WorkAttendance[]

  @@map("workers")
}

model Contract {
  id                String         @id @default(uuid()) @db.Uuid
  workerId          String         @map("worker_id") @db.Uuid
  type              ContractType   @default(FIXED_TERM)
  status            ContractStatus @default(DRAFT)
  startDate         DateTime       @map("start_date")
  endDate           DateTime?      @map("end_date")
  agreedSalary      Decimal        @map("agreed_salary") @db.Decimal(12, 2)
  documentUrl       String?        @map("document_url") @db.VarChar(1000)
  isActive          Boolean        @default(false) @map("is_active")
  observations      String?        @db.Text
  sentAt            DateTime?      @map("sent_at")
  signedAt          DateTime?      @map("signed_at")
  signedBy          String?        @map("signed_by") @db.Uuid
  signatureName     String?        @map("signature_name") @db.VarChar(200)
  signatureHash     String?        @map("signature_hash") @db.VarChar(128)
  rejectionReason   String?        @map("rejection_reason") @db.VarChar(500)
  approvedAt        DateTime?      @map("approved_at")
  approvedBy        String?        @map("approved_by") @db.Uuid
  expiryAlertSentAt DateTime?      @map("expiry_alert_sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  signer   User?  @relation("ContractSigner", fields: [signedBy], references: [id], onDelete: SetNull)
  approver User?  @relation("ContractApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([status])
  @@index([isActive, endDate])
  @@map("contracts")
}

model Payroll {
  id          String        @id @default(uuid()) @db.Uuid
  workerId    String        @map("worker_id") @db.Uuid
  period      String        @db.VarChar(20) // e.g. "2024-11"
  baseSalary  Decimal       @map("base_salary") @db.Decimal(12, 2)
  bonuses     Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?     @map("payment_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, period])
  @@map("payrolls")
}

model WorkAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  workerId     String           @map("worker_id") @db.Uuid
  date         DateTime         @db.Date
  checkInTime  DateTime?        @map("check_in_time") @db.Time
  checkOutTime DateTime?        @map("check_out_time") @db.Time
  status       AttendanceStatus @default(PRESENT)
  observation  String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@map("work_attendances")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 4: Asistencia de Alumnos y Evaluación Docente
// ─────────────────────────────────────────────────────────────────────────────

model ClassAttendance {
  id          String   @id @default(uuid()) @db.Uuid
  cohortId    String   @map("cohort_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  date        DateTime @db.Date
  isPresent   Boolean  @default(true) @map("is_present")
  isExcused   Boolean  @default(false) @map("is_excused")
  observation String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cohort  Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student User          @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([cohortId, date])
  @@index([sessionId])
  @@map("class_attendances")
}

model TeacherEvaluation {
  id          String   @id @default(uuid()) @db.Uuid
  cohortId    String   @map("cohort_id") @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  score       Int      @db.SmallInt // 1 to 5
  comment     String?  @db.Text
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacher User   @relation("EvaluatedTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User   @relation("EvaluatingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentId]) // Un estudiante evalúa a un docente por cohorte una vez
  @@map("teacher_evaluations")
}

// ─────────────────────────────────────────────────────────────────────────────
// FASE 7: Comunicación (Anuncios, Foros, Notificaciones)
// ─────────────────────────────────────────────────────────────────────────────

enum TargetAudience {
  ALL
  TEACHERS
  STUDENTS
}

model Announcement {
  id              String         @id @default(uuid()) @db.Uuid
  title           String         @db.VarChar(200)
  content         String         @db.Text
  type            String         @default("info") @db.VarChar(20) // info, warning, success
  targetAudience  TargetAudience @default(ALL) @map("target_audience")
  authorId        String         @map("author_id") @db.Uuid
  isActive        Boolean        @default(true) @map("is_active")
  // Campos para banners en la Landing Page
  imageUrl        String?        @map("image_url") @db.VarChar(500)
  ctaText         String?        @map("cta_text") @db.VarChar(100)
  ctaUrl          String?        @map("cta_url") @db.VarChar(500)
  showOnLanding   Boolean        @default(false) @map("show_on_landing")
  landingStartsAt DateTime?      @map("landing_starts_at")
  landingEndsAt   DateTime?      @map("landing_ends_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([showOnLanding, isActive, landingStartsAt, landingEndsAt])
  @@map("announcements")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(200)
  message   String?  @db.Text
  type      String?  @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  actionUrl String?  @map("action_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user       User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationChannel {
  INTERNAL
  EMAIL
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Trazabilidad de cada canal de una notificación transaccional.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  notificationId    String?                    @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  recipient         String                     @db.VarChar(255)
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?                    @map("error_message") @db.VarChar(500)
  attempts          Int                        @default(0)
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([userId, channel, createdAt])
  @@index([status, createdAt])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  whatsappEnabled Boolean  @default(true) @map("whatsapp_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  contractAlerts  Boolean  @default(true) @map("contract_alerts")
  academicAlerts  Boolean  @default(true) @map("academic_alerts")
  paymentAlerts   Boolean  @default(true) @map("payment_alerts")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Forum {
  id          String   @id @default(uuid()) @db.Uuid
  cohortId    String   @map("cohort_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  cohort   Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author   User?          @relation("ForumAuthor", fields: [authorId], references: [id])
  messages ForumMessage[]

  @@index([cohortId, isActive])
  @@map("forums")
}

model ForumMessage {
  id        String   @id @default(uuid()) @db.Uuid
  forumId   String   @map("forum_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String   @db.Text
  parentId  String?  @map("parent_id") @db.Uuid // Reply to another message
  createdAt DateTime @default(now()) @map("created_at")

  forum   Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author  User           @relation("ForumMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  ForumMessage?  @relation("ThreadReplies", fields: [parentId], references: [id])
  replies ForumMessage[] @relation("ThreadReplies")

  @@index([forumId, parentId, createdAt])
  @@map("forum_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mensajería Directa (Chat 1-a-1)
// ─────────────────────────────────────────────────────────────────────────────

/// Mensaje directo entre dos usuarios del sistema.
model DirectMessage {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  content    String   @db.Text
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@map("direct_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// Configuración Global de la Plataforma
// ─────────────────────────────────────────────────────────────────────────────

/// Configuración general administrable por el Super Admin
model PlatformSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  academyName         String   @default("Academia Virtual") @map("academy_name") @db.VarChar(150)
  legalName           String?  @map("legal_name") @db.VarChar(200)
  taxId               String?  @map("tax_id") @db.VarChar(30)
  tagline             String?  @db.VarChar(250)
  description         String?  @db.Text
  logoUrl             String?  @map("logo_url") @db.VarChar(2000)
  faviconUrl          String?  @map("favicon_url") @db.VarChar(2000)
  primaryColor        String?  @map("primary_color") @db.VarChar(20)
  whatsappNumber      String?  @map("whatsapp_number") @db.VarChar(50)
  supportEmail        String?  @map("support_email") @db.VarChar(255)
  salesEmail          String?  @map("sales_email") @db.VarChar(255)
  address             String?  @db.VarChar(500)
  facebookUrl         String?  @map("facebook_url") @db.VarChar(2000)
  instagramUrl        String?  @map("instagram_url") @db.VarChar(2000)
  linkedinUrl         String?  @map("linkedin_url") @db.VarChar(2000)
  youtubeUrl          String?  @map("youtube_url") @db.VarChar(2000)
  tiktokUrl           String?  @map("tiktok_url") @db.VarChar(2000)
  xUrl                String?  @map("x_url") @db.VarChar(2000)
  heroEyebrow         String?  @map("hero_eyebrow") @db.VarChar(150)
  heroTitle           String?  @map("hero_title") @db.VarChar(250)
  heroSubtitle        String?  @map("hero_subtitle") @db.Text
  termsUrl            String?  @map("terms_url") @db.VarChar(2000)
  privacyUrl          String?  @map("privacy_url") @db.VarChar(2000)
  certificateTemplate Json?    @map("certificate_template")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

enum ProspectStatus {
  NEW
  CONTACTED
  INTERESTED
  ENROLLED
  LOST
}

/// Persona interesada captada desde la landing o registrada por el equipo comercial.
model Prospect {
  id                    String         @id @default(uuid()) @db.Uuid
  name                  String         @db.VarChar(200)
  email                 String?        @db.VarChar(255)
  phone                 String?        @db.VarChar(50)
  message               String?        @db.Text
  source                String         @default("LANDING") @db.VarChar(50)
  privacyConsentAt      DateTime?      @map("privacy_consent_at")
  privacyConsentVersion String?        @map("privacy_consent_version") @db.VarChar(20)
  status                ProspectStatus @default(NEW)
  cohortId              String?        @map("cohort_id") @db.Uuid
  assignedToId          String?        @map("assigned_to_id") @db.Uuid
  nextFollowUpAt        DateTime?      @map("next_follow_up_at")
  lastContactAt         DateTime?      @map("last_contact_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  cohort     Cohort?        @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      ProspectNote[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([phone])
  @@map("prospects")
}

model ProspectNote {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @map("prospect_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  author   User     @relation("ProspectNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([prospectId, createdAt])
  @@map("prospect_notes")
}

model SupportTicket {
  id            String                @id @default(uuid()) @db.Uuid
  requesterId   String                @map("requester_id") @db.Uuid
  assigneeId    String?               @map("assignee_id") @db.Uuid
  subject       String                @db.VarChar(200)
  description   String                @db.Text
  category      String                @default("GENERAL") @db.VarChar(50)
  status        SupportTicketStatus   @default(OPEN)
  priority      SupportTicketPriority @default(NORMAL)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  lastMessageAt DateTime?             @map("last_message_at")
  closedAt      DateTime?             @map("closed_at")

  requester User                   @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?                  @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  SupportTicketMessage[]

  @@index([requesterId, status])
  @@index([assigneeId, status])
  @@index([status, priority, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  body         String   @db.Text
  internalNote Boolean  @default(false) @map("internal_note")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model OperatingCost {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String?   @map("course_id") @db.Uuid
  cohortId    String?   @map("cohort_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  label       String    @db.VarChar(200)
  amount      Decimal   @db.Decimal(12, 2)
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime? @map("period_end")
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cohort  Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  creator User    @relation("OperatingCostCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([periodStart, periodEnd])
  @@index([courseId])
  @@index([cohortId])
  @@map("operating_costs")
}

model ContentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  version     Int
  snapshot    Json
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@map("content_versions")
}

model ClassroomPost {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @map("cohort_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  title String @db.VarChar(200)
  content String @db.Text
  pinned Boolean @default(false)
  publishedAt DateTime @default(now()) @map("published_at")
  deletedAt DateTime? @map("deleted_at")
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([cohortId, publishedAt])
  @@map("classroom_posts")
}

model ClassroomQuestion {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @map("cohort_id") @db.Uuid
  prompt String @db.Text
  options Json
  correctIndex Int @map("correct_index")
  points Float @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  @@index([cohortId])
  @@map("classroom_questions")
}

model QuizAttempt {
  id String @id @default(uuid()) @db.Uuid
  evaluationId String @map("evaluation_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  number Int
  questions Json
  answers Json
  maxScore Float @map("max_score")
  score Float?
  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime @map("expires_at")
  submittedAt DateTime? @map("submitted_at")
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([evaluationId, studentId, number])
  @@index([studentId, evaluationId])
  @@map("quiz_attempts")
}

model SubmissionRevision {
  id String @id @default(uuid()) @db.Uuid
  deliverableId String @map("deliverable_id") @db.Uuid
  fileUrl String @map("file_url") @db.VarChar(1000)
  fileName String? @map("file_name") @db.VarChar(255)
  comment String? @db.Text
  status String @db.VarChar(20)
  gradeSnapshot Json? @map("grade_snapshot")
  submittedAt DateTime @map("submitted_at")
  archivedAt DateTime @default(now()) @map("archived_at")
  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  @@index([deliverableId, archivedAt])
  @@map("submission_revisions")
}

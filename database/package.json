{
  "name": "orm-academia_virtual-database",
  "version": "0.0.1",
  "description": "Prisma schema, migraciones y seed para Academia Virtual",
  "private": true,
  "scripts": {
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:seed": "npx prisma db seed",
    "prisma:seed:demo": "ts-node prisma/seed-load-test.ts",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma migrate reset",
    "docker:up": "docker compose -f ../docker-compose.yml up -d db",
    "docker:down": "docker compose -f ../docker-compose.yml down"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.5.0",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
